<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:SqlDataMover.App.ViewModels"
        xmlns:loc="using:SqlDataMover.App.Localization"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="760"
        x:Class="SqlDataMover.App.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="SQL Data Mover"
        Width="1150" Height="780"
        MinWidth="980" MinHeight="660"
        WindowStartupLocation="CenterScreen">

    <Design.DataContext>
        <vm:MainViewModel />
    </Design.DataContext>

    <DockPanel Background="{DynamicResource AppBackground}">

        <!-- Шапка -->
        <Border DockPanel.Dock="Top" Padding="24,14" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource CardBorder}">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <Border Width="36" Height="36" CornerRadius="8" Background="{DynamicResource AccentBrush}">
                        <TextBlock Text="DB" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="White" FontWeight="Bold" FontSize="13"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center" Spacing="1">
                        <TextBlock Text="SQL Data Mover" FontSize="19" FontWeight="Bold"/>
                        <TextBlock Text="{Binding Subtitle, Source={x:Static loc:AppStrings.Current}}" FontSize="12"
                                   Foreground="{DynamicResource TextMutedBrush}"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Border Classes="step-circle" Classes.active="{Binding IsStep0Active}">
                            <TextBlock Text="1" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold"/>
                        </Border>
                        <TextBlock Text="{Binding Step1Label, Source={x:Static loc:AppStrings.Current}}" VerticalAlignment="Center" Classes="step-label"
                                   Classes.active="{Binding IsStep0Active}"/>
                    </StackPanel>
                    <TextBlock Text="→" VerticalAlignment="Center" Foreground="{DynamicResource TextMutedBrush}"/>
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Border Classes="step-circle" Classes.active="{Binding IsStep1Active}">
                            <TextBlock Text="2" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold"/>
                        </Border>
                        <TextBlock Text="{Binding Step2Label, Source={x:Static loc:AppStrings.Current}}" VerticalAlignment="Center" Classes="step-label"
                                   Classes.active="{Binding IsStep1Active}"/>
                    </StackPanel>
                    <TextBlock Text="→" VerticalAlignment="Center" Foreground="{DynamicResource TextMutedBrush}"/>
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Border Classes="step-circle" Classes.active="{Binding IsStep2Active}">
                            <TextBlock Text="3" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold"/>
                        </Border>
                        <TextBlock Text="{Binding Step3Label, Source={x:Static loc:AppStrings.Current}}" VerticalAlignment="Center" Classes="step-label"
                                   Classes.active="{Binding IsStep2Active}"/>
                    </StackPanel>
                    <TextBlock Text="→" VerticalAlignment="Center" Foreground="{DynamicResource TextMutedBrush}"/>
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Border Classes="step-circle" Classes.active="{Binding IsStep3Active}">
                            <TextBlock Text="4" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold"/>
                        </Border>
                        <TextBlock Text="{Binding Step4Label, Source={x:Static loc:AppStrings.Current}}" VerticalAlignment="Center" Classes="step-label"
                                   Classes.active="{Binding IsStep3Active}"/>
                    </StackPanel>

                    <ComboBox x:Name="LanguageBox" ItemsSource="{Binding Languages}"
                              SelectedItem="{Binding SelectedLanguage}" Width="110" VerticalAlignment="Center">
                        <ComboBox.ItemTemplate>
                            <DataTemplate DataType="loc:LanguageOption">
                                <TextBlock Text="{Binding DisplayName}"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Подвал: докируется вниз до контента. -->
        <Border DockPanel.Dock="Bottom" Padding="24,12" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource CardBorder}">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <Button x:Name="RestartButton" Content="{Binding Restart, Source={x:Static loc:AppStrings.Current}}" Command="{Binding RestartCommand}" Padding="18,7"/>
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10">
                    <Button x:Name="BackButton" Content="{Binding Back, Source={x:Static loc:AppStrings.Current}}" Command="{Binding GoBackCommand}" Padding="20,7" IsEnabled="{Binding CanGoBack}"/>
                    <Button x:Name="NextButton" Content="{Binding Next, Source={x:Static loc:AppStrings.Current}}" Command="{Binding GoNextCommand}" Classes="primary" Padding="24,7" IsEnabled="{Binding CanGoNext}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Контент шага: последний ребёнок DockPanel заполняет оставшееся место. -->
        <ContentControl Content="{Binding CurrentPage}" Margin="28,20"/>
    </DockPanel>
</Window>
