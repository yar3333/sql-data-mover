<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SqlDataMover.App.ViewModels"
             xmlns:loc="using:SqlDataMover.App.Localization"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="600"
             x:Class="SqlDataMover.App.Views.MappingPageView"
             x:DataType="vm:MappingPageViewModel">

    <DockPanel>
        <StackPanel DockPanel.Dock="Top" Spacing="4" Margin="0,0,0,12">
            <TextBlock Text="{Binding Step3Title, Source={x:Static loc:AppStrings.Current}}" FontSize="20" FontWeight="SemiBold"/>
            <TextBlock Text="{Binding Step3Subtitle, Source={x:Static loc:AppStrings.Current}}"
                       Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap"/>
        </StackPanel>

        <Border Classes="card" Padding="8" IsEnabled="{Binding !IsBusy}">
            <Grid>
                <StackPanel Spacing="8" IsVisible="{Binding !IsBusy}">
                    <TextBlock Text="{Binding TablesToCopy, Source={x:Static loc:AppStrings.Current}}" FontWeight="SemiBold" Margin="8,4,0,0"/>
                    <ScrollViewer MaxHeight="520">
                        <ItemsControl ItemsSource="{Binding Tables}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="vm:TableMappingViewModel">
                                    <StackPanel Margin="8,3" Spacing="2">
                                        <TextBlock Text="{Binding Display}" FontWeight="SemiBold"/>
                                        <ItemsControl ItemsSource="{Binding Columns}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="vm:ColumnChoiceViewModel">
                                                    <CheckBox Content="{Binding Name}" IsChecked="{Binding IsSelected}"
                                                              Margin="0,0,14,0"/>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <TextBlock Text="{Binding SelectAtLeastOne, Source={x:Static loc:AppStrings.Current}}"
                               Foreground="{DynamicResource TextMutedBrush}" Margin="8,2,0,0"
                               IsVisible="{Binding !AllHaveMatchColumns}"/>
                </StackPanel>
                <StackPanel Spacing="8" IsVisible="{Binding IsBusy}">
                    <TextBlock Text="{Binding LoadingColumns, Source={x:Static loc:AppStrings.Current}}" Foreground="{DynamicResource TextMutedBrush}"/>
                    <ProgressBar IsIndeterminate="True" Height="6"/>
                </StackPanel>
            </Grid>
        </Border>
    </DockPanel>
</UserControl>
