<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SqlDataMover.App.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="640"
             x:Class="SqlDataMover.App.Views.PreviewPageView"
             x:DataType="vm:PreviewPageViewModel">

    <DockPanel>
        <StackPanel DockPanel.Dock="Top" Spacing="4" Margin="0,0,0,12">
            <TextBlock Text="Шаг 4. Предпросмотр и копирование" FontSize="20" FontWeight="SemiBold"/>
            <TextBlock Text="Предварительный прогон (без записи) показывает, сколько строк в каждой таблице будет вставлено и обновлено. Запускайте копирование после просмотра статистики."
                       Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap"/>
        </StackPanel>

        <!-- Статистика предпросмотра -->
        <Border DockPanel.Dock="Top" Classes="card" Padding="12" Margin="0,0,0,12">
            <StackPanel Spacing="10">
                <TextBlock Text="Статистика предпросмотра" FontWeight="SemiBold" Margin="4,2,0,0"/>

                <StackPanel Spacing="8" IsVisible="{Binding IsBusy}">
                    <ProgressBar IsIndeterminate="True" Height="6"/>
                    <TextBlock Text="Выполняется предварительный прогон..." Foreground="{DynamicResource TextMutedBrush}"/>
                </StackPanel>

                <StackPanel Spacing="8" IsVisible="{Binding !IsBusy}">
                    <Grid RowDefinitions="Auto,*" IsVisible="{Binding HasPreview}">
                        <Grid ColumnDefinitions="*,150,150,150,*">
                            <TextBlock Text="Таблица" FontWeight="SemiBold" Margin="4,0,0,4"
                                       Foreground="{DynamicResource TextMutedBrush}"/>
                            <TextBlock Grid.Column="1" Text="Прочитано" FontWeight="SemiBold" Margin="4,0,0,4"
                                       Foreground="{DynamicResource TextMutedBrush}" TextAlignment="Right"/>
                            <TextBlock Grid.Column="2" Text="Вставлено" FontWeight="SemiBold" Margin="4,0,0,4"
                                       Foreground="{DynamicResource TextMutedBrush}" TextAlignment="Right"/>
                            <TextBlock Grid.Column="3" Text="Обновлено" FontWeight="SemiBold" Margin="4,0,0,4"
                                       Foreground="{DynamicResource TextMutedBrush}" TextAlignment="Right"/>
                            <TextBlock Grid.Column="4" Text="Статус" FontWeight="SemiBold" Margin="8,0,0,4"
                                       Foreground="{DynamicResource TextMutedBrush}"/>
                        </Grid>

                        <ScrollViewer Grid.Row="1" MaxHeight="300">
                            <ItemsControl ItemsSource="{Binding Tables}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="vm:PreviewTableRow">
                                        <Grid ColumnDefinitions="*,150,150,150,*" MinHeight="26">
                                            <TextBlock Text="{Binding Display}" VerticalAlignment="Center" Margin="4,0,0,0"/>
                                            <TextBlock Grid.Column="1" Text="{Binding RowsRead, StringFormat='{}{0:N0}'}"
                                                       TextAlignment="Right" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="2" Text="{Binding Inserted, StringFormat='{}{0:N0}'}"
                                                       TextAlignment="Right" VerticalAlignment="Center"
                                                       Foreground="{DynamicResource SuccessBrush}"/>
                                            <TextBlock Grid.Column="3" Text="{Binding Updated, StringFormat='{}{0:N0}'}"
                                                       TextAlignment="Right" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="4" Text="✓" VerticalAlignment="Center" Margin="8,0,0,0"
                                                       Foreground="{DynamicResource SuccessBrush}"
                                                       IsVisible="{Binding !HasError}"/>
                                            <TextBlock Grid.Column="4" Text="{Binding Error}" VerticalAlignment="Center"
                                                       Margin="8,0,0,0" Foreground="{DynamicResource DangerBrush}"
                                                       TextWrapping="Wrap" IsVisible="{Binding HasError}"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>

                    <TextBlock Text="Статистика появится после предварительного прогона."
                               IsVisible="{Binding !HasPreview}" Foreground="{DynamicResource TextMutedBrush}"/>
                    <TextBlock x:Name="PreviewSummaryText" Text="{Binding PreviewSummary}" FontWeight="SemiBold" TextWrapping="Wrap"
                               IsVisible="{Binding HasPreview}"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Копирование -->
        <Border DockPanel.Dock="Bottom" Classes="card" Padding="12" Margin="0,12,0,0">
            <StackPanel Spacing="10">
                <Grid ColumnDefinitions="Auto,Auto,*,Auto">
                    <Button Content="Запустить копирование" Command="{Binding StartCopyCommand}" Classes="primary"
                            IsEnabled="{Binding CanStartCopy}"/>
                    <Button Grid.Column="1" Content="Отмена" Command="{Binding CancelCopyCommand}" Margin="10,0,0,0"/>
                    <TextBlock Grid.Column="2" Text="{Binding CurrentTable}" VerticalAlignment="Center"
                               Margin="16,0,0,0" TextWrapping="Wrap"/>
                    <TextBlock Grid.Column="3" Text="{Binding ProcessedRows, StringFormat='Строк: {0:N0}'}"
                               VerticalAlignment="Center" Foreground="{DynamicResource TextMutedBrush}"/>
                </Grid>
                <ProgressBar Height="6" Maximum="100" Value="{Binding ProgressPercent}"
                             IsIndeterminate="{Binding IsProgressIndeterminate}"/>
                <TextBlock Text="{Binding ProgressText}" IsVisible="{Binding IsCopying}"
                           Foreground="{DynamicResource TextMutedBrush}" FontSize="12"/>
                <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap"/>
                <TextBlock Text="{Binding SummaryText}" FontWeight="SemiBold" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <!-- Журнал -->
        <Border Classes="card" Padding="8">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="Журнал" FontWeight="SemiBold" Margin="8,4,8,6"/>
                <ListBox x:Name="LogList" ItemsSource="{Binding Log}" MaxHeight="200">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" FontFamily="Consolas,Menlo,monospace"
                                       FontSize="12" TextWrapping="Wrap"/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>
    </DockPanel>
</UserControl>
